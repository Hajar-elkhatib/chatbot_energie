# Copiez ce fichier vers .env puis renseignez uniquement vos valeurs locales.
# Ne publiez jamais .env ni une clé API dans le navigateur ou dans Git.
# Gemini est prioritaire lorsqu'une clé est renseignée. Sans clé, le chatbot
# conserve son mode local de guidage.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
# Optionnel : OpenAI est utilise seulement si Gemini est absent.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra
# URL interne du backend Spring Boot.
SPRING_BOOT_URL=http://localhost:8080
# Base vectorielle locale utilisée pour sourcer les réponses régionales de Luna.
RAG_SERVICE_URL=http://localhost:8001
# Secret serveur-a-serveur : remplacez-le par une valeur longue et aléatoire en production.
AI_API_KEY=dev-ai-api-key-change-me
# Liste d'origines frontend autorisées, séparées par des virgules.
FRONTEND_ORIGINS=http://localhost:5173
